<?php

/**
 * @file
 * Provides editor form improvements for the Site Platform Admin module.
 */

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_field_widget_single_element_form_alter().
 */
function site_platform_admin_field_widget_single_element_form_alter(array &$element, FormStateInterface $form_state, array $context): void {
  $field_name = $context['items']->getFieldDefinition()->getName();

  if ($field_name !== 'field_icon') {
    return;
  }

  if (!isset($element['value']) || !is_array($element['value'])) {
    return;
  }

  $element['value']['#type'] = 'select';
  $element['value']['#size'] = 1;
  $element['value']['#multiple'] = FALSE;
  $element['value']['#empty_option'] = t('- Select an icon -');
  $element['value']['#options'] = site_platform_admin_icon_options();
  $element['value']['#description'] = t('Choose one frontend-safe icon. The API returns this icon key so the frontend can render it through the React Icons/Lucide icon map.');
}

/**
 * Returns allowed frontend icon choices.
 */
function site_platform_admin_icon_options(): array {
  return [
    'activity' => t('Activity'),
    'award' => t('Award'),
    'briefcase' => t('Briefcase'),
    'check-circle' => t('Check Circle'),
    'cloud' => t('Cloud'),
    'code' => t('Code'),
    'database' => t('Database'),
    'eye' => t('Eye'),
    'github' => t('GitHub'),
    'globe' => t('Globe'),
    'handshake' => t('Handshake'),
    'heart' => t('Heart'),
    'instagram' => t('Instagram'),
    'layers' => t('Layers'),
    'lightbulb' => t('Lightbulb'),
    'linkedin' => t('LinkedIn'),
    'mail' => t('Mail'),
    'map-pin' => t('Map Pin'),
    'mobile' => t('Mobile'),
    'rocket' => t('Rocket'),
    'search' => t('Search'),
    'shield' => t('Shield'),
    'shopping-cart' => t('Shopping Cart'),
    'star' => t('Star'),
    'target' => t('Target'),
    'trending-up' => t('Trending Up'),
    'users' => t('Users'),
    'zap' => t('Zap'),
  ];
}
