# Site Platform environment.
# Valid values: dev, stage, prod
DRUPAL_ENV=dev

# Primary Drupal/backend domain for the current environment.
# Local example: growbig-web.ddev.site
# Production example: admin.growbigllp.com
DRUPAL_PRIMARY_DOMAIN=growbig-web.ddev.site

# Drupal admin/backend domain.
# Local example: admin.growbig-web.ddev.site
# Production example: admin.growbigllp.com
DRUPAL_ADMIN_DOMAIN=admin.growbig-web.ddev.site

# Drupal API domain.
# Local example: api.growbig-web.ddev.site
# Production example: api.growbigllp.com
DRUPAL_API_DOMAIN=api.growbig-web.ddev.site

# Frontend/UI domain.
# Local example: ui.growbig-web.ddev.site
# Production example: growbigllp.com
DRUPAL_UI_DOMAIN=ui.growbig-web.ddev.site

# Optional comma-separated extra trusted hosts.
# Example production alias: www.growbigllp.com
DRUPAL_EXTRA_TRUSTED_HOSTS=dev-admin.growbig-web.ddev.site,dev-api.growbig-web.ddev.site,dev-ui.growbig-web.ddev.site,stage-admin.growbig-web.ddev.site,stage-api.growbig-web.ddev.site,stage-ui.growbig-web.ddev.site,prod-admin.growbig-web.ddev.site,prod-api.growbig-web.ddev.site,prod-ui.growbig-web.ddev.site
